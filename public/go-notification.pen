                          "content": "Define reusable message templates for every channel, and persist in‑app notifications with the built‑in database driver. The same Notification type can render to mail, slack, push, and the database — go-notification stores them as structured rows you can query, mark as read, and stream to your UI.",
                          "lineHeight": 1.6,
                          "fontFamily": "Inter",
                          "fontSize": 15,
                          "fontWeight": "normal"
                        },
