                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "AQsTF",
                                      "fill": "#0F172A",
                                      "content": "db, _ := sql.Open(\"postgres\", \"postgres://app:secret@localhost:5432/app\")",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "aZ6sv",
                                      "fill": "#0F172A",
                                      "content": "driver := dbdriver.New(db, dbdriver.Options{",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "ORJ3q",
                                      "fill": "#0F172A",
                                      "content": "    Schema: \"public\",",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "Jd37U",
                                      "fill": "#0F172A",
                                      "content": "    Table:  \"notifications\",",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "GWCPu",
                                      "fill": "#0F172A",
                                      "content": "})",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "N81JV",
                                      "fill": "#0F172A",
                                      "content": "manager.Register(\"database\", driver)",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    }
