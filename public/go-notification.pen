                                      "fill": "$--syntax-comment",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "// Register SMTP mail driver on the Manager.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "O24xZg",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "mgr := notif.New(",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "CyBOD",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "    notif.WithChannel(\"mail\", mail.NewSMTP(mail.SMTPConfig{",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "LxHvb",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "        Host: \"smtp.mailgun.org\", Port: 587,",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "ndEGT",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "        Username: os.Getenv(\"SMTP_USER\"), Password: os.Getenv(\"SMTP_PASS\"),",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "ZK8ce",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "        From: \"no-reply@kabarkan.id\", TLS: true,",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "VL0s4",
                                      "fill": "#0F172A",
