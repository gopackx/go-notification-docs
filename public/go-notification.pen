                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "X7IYc",
                                      "fill": "$--syntax-comment",
                                      "content": "// Fetch unread notifications for a user",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "aja6X",
                                      "fill": "#0F172A",
                                      "content": "unread, _ := driver.Unread(ctx, user.ID, dbdriver.Limit(20))",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "zuNOq",
                                      "fill": "$--syntax-comment",
                                      "content": "// Mark a notification as read",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "jhfXQ",
                                      "fill": "#0F172A",
                                      "content": "_ = driver.MarkAsRead(ctx, notification.ID)",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "wKQOQ",
                                      "fill": "$--syntax-comment",
                                      "content": "// Stream new notifications via a Go channel",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "ACNq7",
                                      "fill": "#0F172A",
                                      "content": "stream := driver.Subscribe(ctx, user.ID)",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "RVeyF",
                                      "fill": "#0F172A",
                                      "content": "for n := range stream { ws.Send(user.ID, n) }",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    }
                                  ]
