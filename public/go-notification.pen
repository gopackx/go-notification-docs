                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "gcTp4",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "    notify.OnRetry(func(ctx context.Context, ev notify.RetryEvent) {",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
