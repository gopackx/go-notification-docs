                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "XnPiX",
                                      "fill": "$--syntax-comment",
                                      "content": "// Fetch unread notifications for a user",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "YXAfE",
                                      "fill": "#0F172A",
                                      "content": "unread, _ := driver.Unread(ctx, user.ID, dbdriver.Limit(20))",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
