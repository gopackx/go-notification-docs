                                      "type": "text",
                                      "id": "a11OR",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "        slog.Warn(\"retry\", \"attempt\", ev.Attempt, \"err\", ev.Err)",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
