                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "    notify.OnSent(func(ctx context.Context, ev notify.SentEvent) {",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "y57WjP",
                                      "fill": "#0F172A",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "        metrics.Counter(\"notify.sent\").Inc(\"channel\", ev.Channel)",
                                      "lineHeight": 1.6,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "PIQvE",
                                      "fill": "#0F172A",
