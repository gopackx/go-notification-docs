                                      "fill": "#0F172A",
                                      "content": "func (n OrderShipped) ToSlack(_ notification.Notifiable) *slack.Message {",
                                      "lineHeight": 1.5,
                                      "fontFamily": "JetBrains Mono",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
